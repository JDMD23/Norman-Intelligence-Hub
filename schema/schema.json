{
  "workbook": "Norman AI Intelligence Hub",
  "version": "V3.0.0",
  "source": "https://docs.google.com/spreadsheets/d/1qZlc8BUZRObyoeygAToWicor-UFFLmO_aCjk3axBhdE",
  "contract": "Unknown values stay BLANK, never 0. IDs are immutable and never reused. Input tabs hold no formulas in input columns; calc columns hold no typed values. All cross-tab references go through named ranges. Vocabulary lives in Reference; add new values there first. Every automation appends a Changelog row.",
  "tabs": {
    "Lease Comps": {
      "columns": [
        {
          "column": "A",
          "header": "Comp ID",
          "key": "comp_id",
          "type": "id",
          "role": "input",
          "required": true,
          "description": "AUTO-ASSIGNED by onEdit trigger when Tenant is entered. API writers must supply IDs. Immutable, never reused."
        },
        {
          "column": "B",
          "header": "Date Signed",
          "key": "date",
          "type": "date",
          "role": "input",
          "required": true,
          "description": "Lease execution date."
        },
        {
          "column": "C",
          "header": "Tenant",
          "key": "tenant",
          "type": "text",
          "role": "input",
          "required": true,
          "description": "Tenant display name as signed. Variants map via Reference!VariantMap."
        },
        {
          "column": "D",
          "header": "Company ID",
          "key": "company_id",
          "type": "id",
          "role": "input",
          "required": true,
          "enum_named_range": "CompanyIds",
          "description": "FK to Companies. AUTO-ASSIGNED with Comp ID."
        },
        {
          "column": "E",
          "header": "Address",
          "key": "address",
          "type": "text",
          "role": "input",
          "required": true,
          "description": "Building street address."
        },
        {
          "column": "F",
          "header": "Submarket",
          "key": "submarket",
          "type": "text",
          "role": "input",
          "required": true,
          "enum_named_range": "Submarkets",
          "description": "Canonical submarket."
        },
        {
          "column": "G",
          "header": "Building Class",
          "key": "bclass",
          "type": "text",
          "role": "input",
          "required": false,
          "enum_named_range": "BuildingClasses",
          "description": "Building class."
        },
        {
          "column": "H",
          "header": "Floor(s)",
          "key": "floors",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Floor(s) leased."
        },
        {
          "column": "I",
          "header": "Condition",
          "key": "condition",
          "type": "text",
          "role": "input",
          "required": false,
          "enum_named_range": "Conditions",
          "description": "Space condition at signing."
        },
        {
          "column": "J",
          "header": "Deal Type",
          "key": "deal_type",
          "type": "text",
          "role": "input",
          "required": false,
          "enum_named_range": "DealTypes",
          "description": "Deal structure."
        },
        {
          "column": "K",
          "header": "Delivery Condition",
          "key": "delivery",
          "type": "text",
          "role": "input",
          "required": false,
          "enum_named_range": "DeliveryConditions",
          "description": "Landlord delivery condition."
        },
        {
          "column": "L",
          "header": "RSF",
          "key": "rsf",
          "type": "int",
          "role": "input",
          "required": true,
          "description": "Rentable square feet."
        },
        {
          "column": "M",
          "header": "Seats",
          "key": "seats",
          "type": "int",
          "role": "input",
          "required": false,
          "description": "Seat count. Blank = unknown (never 0)."
        },
        {
          "column": "N",
          "header": "Term (Years)",
          "key": "term",
          "type": "num",
          "role": "input",
          "required": true,
          "description": "Lease term in years. Fractional allowed."
        },
        {
          "column": "O",
          "header": "Rent P1 ($/RSF, mo 1-60)",
          "key": "rent_p1",
          "type": "rent",
          "role": "input",
          "required": true,
          "description": "Tranche-1 rent, flat through month 60 (or term end if shorter)."
        },
        {
          "column": "P",
          "header": "Rent P2 ($/RSF, mo 61-120)",
          "key": "rent_p2",
          "type": "rent",
          "role": "input",
          "required": false,
          "description": "Tranche-2 rent, months 61-120. BLANK = carries P1 flat (no assumed escalation)."
        },
        {
          "column": "Q",
          "header": "Rent P3 ($/RSF, mo 121+)",
          "key": "rent_p3",
          "type": "rent",
          "role": "input",
          "required": false,
          "description": "Tranche-3 rent, months 121+. BLANK = carries P2 flat."
        },
        {
          "column": "R",
          "header": "Free Rent (months)",
          "key": "free_mo",
          "type": "num",
          "role": "input",
          "required": false,
          "description": "Free rent concession in months."
        },
        {
          "column": "S",
          "header": "TI $/SF",
          "key": "ti_psf",
          "type": "rent",
          "role": "input",
          "required": false,
          "description": "TI allowance per SF. Blank = unknown (NER stays blank). Confirmed-zero on as-is deals is a real 0."
        },
        {
          "column": "T",
          "header": "Comp Source",
          "key": "source",
          "type": "text",
          "role": "input",
          "required": false,
          "enum_named_range": "CompSources",
          "description": "Where this comp came from."
        },
        {
          "column": "U",
          "header": "Verified Date",
          "key": "verified",
          "type": "date",
          "role": "input",
          "required": false,
          "description": "When this comp was last verified. >6 months old flips status to STALE - REVERIFY."
        },
        {
          "column": "V",
          "header": "Latest Round Date",
          "key": "lr_date",
          "type": "date",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF($D{r}=\"\",\"\",IF(COUNTIF(FundingRounds_CompanyIds,$D{r})=0,\"\",MAXIFS(FundingRounds_Dates,FundingRounds_CompanyIds,$D{r})))",
          "description": "Most recent round date (wired lookup — never type here; source of truth lives in the referenced tab) -> Funding Rounds."
        },
        {
          "column": "W",
          "header": "Latest Round Type",
          "key": "lr_type",
          "type": "text",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($D{r}=\"\",$V{r}=\"\"),\"\",IFERROR(INDEX(SORT(FILTER({FundingRounds_Dates,FundingRounds_Types},FundingRounds_CompanyIds=$D{r}),1,FALSE),1,2),\"\"))",
          "description": "Type of most recent round (wired lookup — never type here; source of truth lives in the referenced tab) -> Funding Rounds."
        },
        {
          "column": "X",
          "header": "Latest Round Amt ($M)",
          "key": "lr_amt",
          "type": "num",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($D{r}=\"\",$V{r}=\"\"),\"\",IFERROR(LET(a,INDEX(SORT(FILTER({FundingRounds_Dates,FundingRounds_Amounts},FundingRounds_CompanyIds=$D{r}),1,FALSE),1,2),IF(a=0,\"\",a)),\"\"))",
          "description": "Amount of most recent round (wired lookup — never type here; source of truth lives in the referenced tab) -> Funding Rounds."
        },
        {
          "column": "Y",
          "header": "Total Tracked Funding ($M)",
          "key": "total_fund",
          "type": "num",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF($D{r}=\"\",\"\",IFERROR(LET(t,INDEX('Company Metrics'!$M:$M,MATCH($D{r},'Company Metrics'!$A:$A,0)),IF(OR(t=\"\",t=0),\"\",t)),\"\"))",
          "description": "Sum of tracked rounds (wired lookup — never type here; source of truth lives in the referenced tab) -> Company Metrics. Blank (never 0) when tracked rounds have no amounts. Semantic: tracked receipts, not researched narrative totals."
        },
        {
          "column": "Z",
          "header": "Company (canonical)",
          "key": "company",
          "type": "text",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF($D{r}=\"\",\"\",IFERROR(INDEX(Companies!$B:$B,MATCH($D{r},Companies!$A:$A,0)),\"UNKNOWN ID\"))",
          "description": "Canonical company name (wired lookup — never type here; source of truth lives in the referenced tab) -> Companies."
        },
        {
          "column": "AA",
          "header": "HQ City",
          "key": "hq",
          "type": "text",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF($D{r}=\"\",\"\",IFERROR(LET(h,INDEX(Companies!$G:$G,MATCH($D{r},Companies!$A:$A,0)),IF(h=0,\"\",h)),\"\"))",
          "description": "HQ city (wired lookup — never type here; source of truth lives in the referenced tab) -> Companies."
        },
        {
          "column": "AB",
          "header": "Notes",
          "key": "notes",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Free-form deal notes."
        },
        {
          "column": "AC",
          "header": "Year 1 Rent ($)",
          "key": "y1_rent",
          "type": "usd",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(L{r}=\"\",O{r}=\"\"),\"\",L{r}*O{r})",
          "description": "RSF x P1 rent."
        },
        {
          "column": "AD",
          "header": "Free Rent $ Value",
          "key": "free_val",
          "type": "usd",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(R{r}=\"\",O{r}=\"\",L{r}=\"\"),\"\",R{r}/12*O{r}*L{r})",
          "description": "(Free months / 12) x P1 rent x RSF."
        },
        {
          "column": "AE",
          "header": "TI Allowance Total ($)",
          "key": "ti_total",
          "type": "usd",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(S{r}=\"\",L{r}=\"\"),\"\",S{r}*L{r})",
          "description": "TI $/SF x RSF."
        },
        {
          "column": "AF",
          "header": "Projected Gross Rent (Term)",
          "key": "pgr",
          "type": "usd",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($L{r}=\"\",$N{r}=\"\",$O{r}=\"\"),\"\",LET(nmo,ROUND($N{r}*12,0),rz,$O{r},rsix,IF($P{r}=\"\",rz,$P{r}),relev,IF($Q{r}=\"\",rsix,$Q{r}),mA,MIN(nmo,60),mB,MIN(MAX(nmo-60,0),60),mC,MAX(nmo-120,0),$L{r}*(rz*mA+rsix*mB+relev*mC)/12))",
          "description": "Nominal rent over the term on FLAT tranches (no assumed escalation)."
        },
        {
          "column": "AG",
          "header": "Avg Rate ($/RSF/Yr)",
          "key": "avg_rate",
          "type": "rent",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($AF{r}=\"\",$L{r}=\"\",$N{r}=\"\"),\"\",$AF{r}/$L{r}/$N{r})",
          "description": "Projected Gross / RSF / Term."
        },
        {
          "column": "AH",
          "header": "NER Annuity ($/RSF/Yr) @ 6%",
          "key": "ner",
          "type": "rent",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($N{r}=\"\",$O{r}=\"\",$S{r}=\"\"),\"\",LET(nmo,ROUND($N{r}*12,0),im,0.06/12,rz,$O{r},rsix,IF($P{r}=\"\",rz,$P{r}),relev,IF($Q{r}=\"\",rsix,$Q{r}),mos,SEQUENCE(nmo),pvbeg,SUMPRODUCT(MAP(mos,LAMBDA(mm,IF(mm<=60,rz,IF(mm<=120,rsix,relev))/12*(1+im)^-(mm-1)))),afbeg,(1-(1+im)^-nmo)/im/12*(1+im),freemo,IF($R{r}=\"\",0,$R{r}),ROUND(pvbeg/afbeg,2)-(freemo/12*rz+$S{r})/afbeg))",
          "description": "Baseline NER per docs/NER_MODEL.md: monthly 6%/12 discounting, beg-of-month, flat tranches, free rent + TI nominal upfront, levelized. Blank when TI unknown."
        },
        {
          "column": "AI",
          "header": "Cost/Seat (Year 1)",
          "key": "cost_seat",
          "type": "usd",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(AC{r}=\"\",M{r}=\"\",M{r}=0),\"\",AC{r}/M{r})",
          "description": "Year 1 Rent / Seats."
        },
        {
          "column": "AJ",
          "header": "RSF / Seat",
          "key": "rsf_seat",
          "type": "num1",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(L{r}=\"\",M{r}=\"\",M{r}=0),\"\",L{r}/M{r})",
          "description": "Density: RSF / Seats."
        },
        {
          "column": "AK",
          "header": "Rent-to-Raise (Yr 1) %",
          "key": "rent_raise",
          "type": "pct",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($AC{r}=\"\",$X{r}=\"\"),\"\",$AC{r}/($X{r}*1000000))",
          "description": "Year 1 Rent / wired latest round."
        },
        {
          "column": "AL",
          "header": "Lease-to-Total-Funding %",
          "key": "l2tf",
          "type": "pct",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($AF{r}=\"\",$Y{r}=\"\",$Y{r}=0),\"\",$AF{r}/($Y{r}*1000000))",
          "description": "Projected Gross / wired total tracked funding."
        },
        {
          "column": "AM",
          "header": "Months of Rent Covered",
          "key": "mo_cover",
          "type": "num1",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR($Y{r}=\"\",$AC{r}=\"\",$AC{r}=0),\"\",($Y{r}*1000000)/($AC{r}/12))",
          "description": "Total tracked funding / monthly Year-1 rent."
        },
        {
          "column": "AN",
          "header": "Record Status",
          "key": "status",
          "type": "text",
          "role": "qa",
          "required": false,
          "enum_named_range": "RecordStatuses",
          "formula_pattern": "=IF($C{r}=\"\",\"\",IF(OR($A{r}=\"\",$L{r}=\"\",$N{r}=\"\",$O{r}=\"\",$B{r}=\"\",$F{r}=\"\"),\"MISSING INPUTS\",IF(OR($M{r}=\"\",$S{r}=\"\"),\"NEEDS REVIEW\",IF(AND($U{r}<>\"\",$U{r}<TODAY()-180),\"STALE - REVERIFY\",\"READY\"))))",
          "description": "READY / NEEDS REVIEW / MISSING INPUTS / STALE - REVERIFY (verified >6mo ago) — computed, never typed."
        },
        {
          "column": "AO",
          "header": "QA Notes",
          "key": "qa",
          "type": "text",
          "role": "qa",
          "required": false,
          "formula_pattern": "(auto list incl. staleness)",
          "description": "Auto list of missing fields + staleness flag."
        }
      ]
    },
    "Companies": {
      "columns": [
        {
          "column": "A",
          "header": "Company ID",
          "key": "company_id",
          "type": "id",
          "role": "input",
          "required": true,
          "description": "AUTO-ASSIGNED by onEdit trigger when Canonical Name is entered. Immutable, never reused. FK target for Lease Comps + Funding Rounds."
        },
        {
          "column": "B",
          "header": "Canonical Name",
          "key": "name",
          "type": "text",
          "role": "input",
          "required": true,
          "description": "One row per real company. Tenant-name variants map here via Reference!VariantMap."
        },
        {
          "column": "C",
          "header": "Crunchbase URL",
          "key": "cb_url",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Verified Crunchbase profile."
        },
        {
          "column": "D",
          "header": "Website",
          "key": "website",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Company website."
        },
        {
          "column": "E",
          "header": "Industry",
          "key": "industry",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Industry label."
        },
        {
          "column": "F",
          "header": "Founded Year",
          "key": "founded",
          "type": "int",
          "role": "input",
          "required": false,
          "description": "Founding year."
        },
        {
          "column": "G",
          "header": "HQ City",
          "key": "hq",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Headquarters city."
        },
        {
          "column": "H",
          "header": "Funding History (text)",
          "key": "fund_hist",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Narrative funding history (research output)."
        },
        {
          "column": "I",
          "header": "Funding Velocity Detail",
          "key": "velocity",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Narrative velocity summary (research output)."
        },
        {
          "column": "J",
          "header": "Funding Accel/Decel Note",
          "key": "accel",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Acceleration/deceleration read."
        },
        {
          "column": "K",
          "header": "Sources",
          "key": "sources",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Research source list."
        },
        {
          "column": "L",
          "header": "Notes",
          "key": "notes",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Identity caveats (e.g. Mirage<->Captions), review flags."
        }
      ]
    },
    "Funding Rounds": {
      "columns": [
        {
          "column": "A",
          "header": "Round ID",
          "key": "round_id",
          "type": "id",
          "role": "input",
          "required": true,
          "description": "AUTO-ASSIGNED by onEdit trigger when row data is entered. API writers must supply IDs. Immutable, never reused."
        },
        {
          "column": "B",
          "header": "Company ID",
          "key": "company_id",
          "type": "id",
          "role": "input",
          "required": true,
          "enum_named_range": "CompanyIds",
          "description": "FK to Companies."
        },
        {
          "column": "C",
          "header": "Company",
          "key": "company",
          "type": "text",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(B{r}=\"\",\"\",IFERROR(INDEX(Companies!B:B,MATCH(B{r},Companies!A:A,0)),\"UNKNOWN ID\"))",
          "description": "Looked up from Companies by ID."
        },
        {
          "column": "D",
          "header": "Round Number",
          "key": "round_no",
          "type": "int",
          "role": "input",
          "required": false,
          "description": "Sequence number within company."
        },
        {
          "column": "E",
          "header": "Round Type",
          "key": "round_type",
          "type": "text",
          "role": "input",
          "required": true,
          "enum_named_range": "RoundTypes",
          "description": "Round type."
        },
        {
          "column": "F",
          "header": "Round Date",
          "key": "date",
          "type": "date",
          "role": "input",
          "required": true,
          "description": "Round announcement date."
        },
        {
          "column": "G",
          "header": "Round Amount ($M)",
          "key": "amount",
          "type": "num",
          "role": "input",
          "required": false,
          "description": "Round size in $M."
        },
        {
          "column": "H",
          "header": "Lead Investors",
          "key": "investors",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Lead investors."
        },
        {
          "column": "I",
          "header": "Cumulative After Round ($M)",
          "key": "cumulative",
          "type": "num",
          "role": "input",
          "required": false,
          "description": "Reported cumulative funding (may include undisclosed prior base). QA cross-checks vs running sum."
        },
        {
          "column": "J",
          "header": "Months Since Prior Round",
          "key": "mo_prior",
          "type": "int",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(B{r}=\"\",F{r}=\"\"),\"\",LET(pd,MAXIFS(F$2:F$3000,B$2:B${MAX},B{r},F$2:F${MAX},\"<\"&F{r}),IF(pd=0,\"\",DATEDIF(pd,F{r},\"M\"))))",
          "description": "Computed from previous round of same company."
        },
        {
          "column": "K",
          "header": "Source",
          "key": "source",
          "type": "text",
          "role": "input",
          "required": true,
          "description": "Source name."
        },
        {
          "column": "L",
          "header": "Source URL",
          "key": "source_url",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Source link."
        },
        {
          "column": "M",
          "header": "Confidence",
          "key": "confidence",
          "type": "text",
          "role": "input",
          "required": true,
          "enum_named_range": "ConfidenceLevels",
          "description": "HIGH / MEDIUM / LOW / REVIEW."
        },
        {
          "column": "N",
          "header": "Notes",
          "key": "notes",
          "type": "text",
          "role": "input",
          "required": false,
          "description": "Disclosed prior-base notes, dedupe decisions, intentional-duplicate markers."
        }
      ]
    },
    "Company Metrics": {
      "columns": [
        {
          "column": "A",
          "header": "Company ID",
          "key": "company_id",
          "type": "id",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(Companies!A{r}=\"\",\"\",Companies!A{r})",
          "description": "Mirror of Companies!A."
        },
        {
          "column": "B",
          "header": "Company",
          "key": "name",
          "type": "text",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(Companies!A{r}=\"\",\"\",Companies!B{r})",
          "description": "Mirror of Companies!B."
        },
        {
          "column": "C",
          "header": "Signed Lease Count",
          "key": "comps",
          "type": "int",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(A{r}=\"\",\"\",COUNTIF(LeaseComps_CompanyIds,A{r}))",
          "description": "Count of lease comps for this company."
        },
        {
          "column": "D",
          "header": "Latest Signed Lease",
          "key": "latest_lease",
          "type": "date",
          "role": "calc",
          "required": false,
          "formula_pattern": "=IF(OR(A{r}=\"\",C{r}=0),\"\",MAXIFS(LeaseComps_Dates,LeaseComps_CompanyIds,A{r}))",
          "description": "Most recent signing date."
        },
        {
          "column": "E",
          "header": "Avg RSF",
          "key": "avg_rsf",
          "type": "num1",
          "role": "calc",
          "required": false,
